[
  {
    "id": "day1_hub_intro",
    "priority": 10,
    "context": "hub",
    "trigger": "hubReady",
    "triggerParam": null,
    "resumePolicy": "restart",
    "activationConditions": null,
    "steps": [
      {
        "id": "welcome",
        "type": "showText",
        "text": "Welcome to your bookshop! Let's run your first day.",
        "placement": "bottom"
      },
      {
        "id": "point_start",
        "type": "highlightClick",
        "target": "hub.start_day_button",
        "pointer": true,
        "text": "Tap Start Day to choose a location.",
        "placement": "aboveTarget",
        "padding": 16
      },
      {
        "id": "wait_location_window",
        "type": "awaitWindow",
        "window": "location"
      },
      {
        "id": "guide_location",
        "type": "showText",
        "text": "Pick a location to visit today.",
        "placement": "bottom"
      },
      {
        "id": "wait_preparation_window",
        "type": "awaitWindow",
        "window": "preparation"
      },
      {
        "id": "guide_stock",
        "type": "showText",
        "text": "Stock your shelf: add books by genre, then tap Open Shop to start selling.",
        "placement": "bottom"
      },
      {
        "id": "wait_results_window",
        "type": "awaitWindow",
        "window": "results"
      },
      {
        "id": "wrap_up",
        "type": "showText",
        "text": "Day complete - nice work! Each day you'll stock, sell, and review your results.",
        "placement": "bottom"
      }
    ]
  }
]
